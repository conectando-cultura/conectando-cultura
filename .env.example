# ─── Backend ────────────────────────────────────────────────────────────────
# Puerto de la API Express (por defecto 3001).
PORT=3001

# ─── Supabase (opcional) ────────────────────────────────────────────────────
# Sin estas variables el backend funciona igual con el repositorio local
# en backend/data/*.json. Se completan en:
#   Supabase → Settings → API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# OJO: la service role key salta RLS. Es secret de servidor: nunca la
# pongas en una variable VITE_* ni la expongas al frontend.

# ─── Frontend ───────────────────────────────────────────────────────────────
# El cliente HTTP usa rutas relativas ("/api") y el proxy de Vite las
# reenvía al backend en desarrollo. No hace falta configurar ninguna URL.
# En producción, el backend tiene que servirse en el mismo dominio que
# la SPA (reverse proxy) o cambiar BASE en frontend/src/api/client.ts.

# ─── Pendiente: Sprint 8 (alertas por correo) ───────────────────────────────
# Ver https://resend.com → API Keys
RESEND_API_KEY=re_your_api_key
RESEND_FROM_EMAIL=notificaciones@conectandocultura.ar
