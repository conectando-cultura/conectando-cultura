# ─── Backend (Express local) ─────────────────────────────────────────────────
PORT=3001

# ─── Supabase ───────────────────────────────────────────────────────────────
# Lo obtienes de: https://supabase.com/dashboard → tu proyecto → Settings → API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Frontend (Vite) ────────────────────────────────────────────────────────
# URL base de la API cuando se deploya (se completa con el deploy de backend)
VITE_API_URL=http://localhost:3001

# ─── Resend (notificaciones email) ─────────────────────────────────────────
# Lo obtienes de: https://resend.com → API Keys
RESEND_API_KEY=re_your_api_key
RESEND_FROM_EMAIL=notificaciones@conectandocultura.ar
