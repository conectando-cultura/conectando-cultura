# ─── Backend ────────────────────────────────────────────────────────────────
# Puerto de la API Express (por defecto 3001).
PORT=3001

# ─── Base de Datos Principal: MySQL 8.0+ (Local / Servidor Propio) ──────────
# Esquema inicial y seed en: mysql/001_schema_y_seed.sql
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=conectando_cultura

# ─── Base de Datos de Respaldo (Backup & Keep-Alive): Supabase ──────────────
# Si se configuran estas credenciales, el backend:
#   1. Replica asincrónicamente las escrituras de MySQL en Supabase.
#   2. Ejecuta un keep-alive automático (`SELECT 1`) cada 3 días (72 h) para
#      evitar que el plan gratuito de Supabase pause el proyecto por inactividad.
#   3. Habilita en el Panel Admin (exclusivo rol `admin`) el monitor de estado,
#      ping manual y sincronización completa MySQL -> Supabase.
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# OJO: la service role key salta RLS. Es secret de servidor: nunca la
# pongas en una variable VITE_* ni la expongas al frontend.

# ─── Frontend ───────────────────────────────────────────────────────────────
# El cliente HTTP usa rutas relativas ("/api") y el proxy de Vite las
# reenvía al backend en desarrollo. No hace falta configurar ninguna URL.
# En producción, el backend tiene que servirse en el mismo dominio que
# la SPA (reverse proxy) o cambiar BASE en frontend/src/api/client.ts.

# ─── Alertas por Correo (Resend) ────────────────────────────────────────────
# Ver https://resend.com → API Keys
RESEND_API_KEY=re_your_api_key
RESEND_FROM_EMAIL=notificaciones@conectandocultura.ar
